<?xml version="1.0" encoding="UTF-8"?>

<Values version="2.0">
  <value name="enabled">yes</value>
  <value name="version">1.0.0.0.1</value>
  <value name="jvm_version">21</value>
  <value name="publisher">Luis Loja</value>
  <value name="description">IBM webMethods Adapter for SSH</value>
  <value name="build">1</value>
  <value name="subsystem">true</value>
  <value name="product_id">sshAdapter</value>
  <record name="startup_services" javaclass="com.wm.util.Values">
    <null name="wm.adapter.wxssh.admin:registerAdapter"/>
  </record>
  <record name="shutdown_services" javaclass="com.wm.util.Values">
    <null name="wm.adapter.wxssh.admin:unregisterAdapter"/>
  </record>
  <null name="replication_services"/>
  <record name="requires" javaclass="com.wm.util.Values">
    <value name="WmART">*.*</value>
  </record>
  <null name="browseacl"/>
  <value name="listACL">Developers</value>
  <value name="system_package">yes</value>
  <value name="classloader">package</value>
</Values>
